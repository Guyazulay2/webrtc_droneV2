# ─── EXAMPLE ONLY — לא לcommit! ────────────────────────────────────────────────
# העתק ל: secrets/production.env
# הרץ: make push-secrets כדי לדחוף ל-AWS Secrets Manager
# ─────────────────────────────────────────────────────────────────────────────

# STUN server — גילוי IP חיצוני (ניתן להשאיר את Google STUN הציבורי)
STUN_SERVER=stun://stun.l.google.com:19302

# TURN server — relay של WebRTC media כשאין קו ישיר (חובה ב-production)
# hostname/IP של ה-COTURN EC2 שנוצר ע"י Terraform
TURN_HOST=turn.yourdomain.com

# HMAC shared secret של COTURN (נוצר ע"י Terraform ב-AWS Secrets Manager)
# זה לא username/password — זה המפתח שמייצר credentials זמניים
# הערך יתמלא אוטומטית אחרי: terraform output turn_secret
TURN_SECRET=changeme_replace_with_terraform_output
